{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "data": {
          ".validate": "newData.hasChildren(['tab','mes','months','gp','gl','ing'])"
        }
      }
    },
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
